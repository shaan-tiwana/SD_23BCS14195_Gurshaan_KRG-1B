  <diagram name="Page-1" id="wxbkWfwqtEQ0AzTHEMOG">
    <mxGraphModel dx="2816" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_rWnpoFQO4X-sXkaS9lH-1" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;&lt;u&gt;SYSTEM DESIGN LAB MST&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Design a Hotstar like application with the following requirments:&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;a) User Login service&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;b) Subscribe service&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;c) Movie/TV show search service&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;d) Movie/TV show Play Service&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Optimise the application using CDC pipeline, Highlight where proxy design pattern can be used. Use HLS and DASH for specific live / static content playing along with manifest file.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="780" x="-815" y="20" as="geometry" />
        </mxCell>
        <mxCell id="_rWnpoFQO4X-sXkaS9lH-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;FUNCTIONAL REQUIRMENTS&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;1) Client should be able to create account, login and manage sessions on multiple devices.&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;2) Client should be able to view available plans, subscribe + pay, see payment history in the account&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;3) Client should be able to search for movies or shows by keywords and filter the search results.&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;4) Client should be able to watch the content in any resolution available(manual or adaptive bitrate streaming), be able to play/pause, subtitles, etc.&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;5) Client should be able see the thumbnails, preview, decription, metadata of the titles.&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;6) Client must get the content recommendation on the homescreen based upon the watch and search history.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NON-FUNCTIONAL REQUIRMENTS&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;1) Scalability: Platform should support millions of users, shoulld be able to handle millions of concurrent streams&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;2) Here, Avalability is more important than Consistency (CAP Theorm)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;3) Avalability should be around 99.9% uptime.&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;4) Latency should low (50ms - 100ms)[CDNs can be used here]&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;5) Buffering should be very very low&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="785" x="-815" y="250" as="geometry" />
        </mxCell>
